{
  "name": "all-around-keyboard",
  "author": "micahscopes",
  "version": "1.9.0",
  "description": "Round piano keyboards with Web Components + d3-shape",
  "type": "module",
  "types": "./src/main.d.ts",
  "main": "dist/all-around-keyboard.js",
  "module": "dist/all-around-keyboard.esm.js",
  "browser": "dist/all-around-keyboard.min.js",
  "unpkg": "dist/all-around-keyboard.min.js",
  "jsdelivr": "dist/all-around-keyboard.min.js",
  "exports": {
    ".": {
      "types": "./src/main.d.ts",
      "import": "./dist/all-around-keyboard.esm.js",
      "require": "./dist/all-around-keyboard.js",
      "browser": "./dist/all-around-keyboard.min.js",
      "default": "./dist/all-around-keyboard.esm.js"
    },
    "./min": {
      "types": "./src/main.d.ts",
      "import": "./dist/all-around-keyboard.esm.min.js",
      "require": "./dist/all-around-keyboard.min.js",
      "default": "./dist/all-around-keyboard.esm.min.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "docs": "cp dist/all-around-keyboard.js dist/all-around-keyboard.min.js docs/lib/"
  },
  "dependencies": {
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.63.0",
    "rollup-plugin-string": "^3.0.0"
  },
  "keywords": [
    "keyboard",
    "piano",
    "music",
    "web-components",
    "custom-elements",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/micahscopes/all-around-keyboard"
  },
  "license": "MIT"
}
